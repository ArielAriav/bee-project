# Use when the backend is on a different host than the frontend.
# VITE_API_BASE=https://bee-vision.duckdns.org

# If unset and the page is HTTPS, the app uses the same origin (requires Caddy
# to proxy /ws, /upload-video, /get-result, /video-feed, /stop-session to port 8000).
