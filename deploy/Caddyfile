# Caddy config for bee-vision.duckdns.org
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Requires: bee-backend on 127.0.0.1:8000, bee-frontend (Vite) on 127.0.0.1:5173

bee-vision.duckdns.org {
	# FastAPI backend (HTTP + WebSocket) — must come BEFORE the frontend catch-all
	@backend_paths {
		path /ws/*
		path /upload-video
		path /get-result
		path /video-feed*
		path /stop-session
		path /docs*
		path /openapi.json
	}
	handle @backend_paths {
		reverse_proxy 127.0.0.1:8000
	}

	# React / Vite dev server
	handle {
		reverse_proxy 127.0.0.1:5173
	}
}
